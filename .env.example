# App (Next.js). Copiar a .env.local.
# Valores locales: los imprime `npx supabase status` (API_URL y PUBLISHABLE_KEY).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# URL pública de la web (callback de login). En Vercel NO hace falta: se usa el dominio de
# producción o la URL de cada preview automáticamente. Ponla solo con un dominio propio.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Solo tests de base de datos (nunca en el cliente ni en Vercel): SECRET_KEY de `npx supabase status`.
SUPABASE_SECRET_KEY=

# Invitación oficial al Discord de la comunidad (opcional; p. ej. https://discord.gg/xxxx). Sin ella no se muestra el enlace.
NEXT_PUBLIC_DISCORD_INVITE_URL=

# Acceso por enlace de correo: "off" lo oculta (usar en producción hasta tener un SMTP propio en Supabase).
NEXT_PUBLIC_EMAIL_LOGIN=

# Verificación de Google Search Console (método «etiqueta HTML»): solo el valor de content="...".
# Opcional: sin ella se usa la de teamfinder-seven.vercel.app (src/lib/config.ts). Con dominio propio, pon la suya.
GOOGLE_SITE_VERIFICATION=

# Opcional: cambia el responsable y el correo de contacto que muestran Normas y Privacidad (por defecto, los de src/lib/legal.ts).
NEXT_PUBLIC_LEGAL_OWNER=
NEXT_PUBLIC_CONTACT_EMAIL=

# Notificaciones push (opcionales). Generar con: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
# Secreto compartido con la base de datos (el mismo valor en private.app_settings, clave push_webhook_secret), 32+ caracteres.
# PUSH_WEBHOOK_SECRET=

# Opcional, solo producción (Vercel → Settings → Environment Variables → Production): webhook de un
# canal PRIVADO de Discord para avisos de errores del servidor (src/instrumentation.ts).
# Formato: https://discord.com/api/webhooks/<id>/<token>. Vacía o no válida = sin avisos. Es un secreto.
# ERROR_WEBHOOK_URL=
